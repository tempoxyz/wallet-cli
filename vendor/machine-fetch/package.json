{
  "name": "machine-fetch",
  "version": "0.3.0",
  "description": "Fetch with automatic machine-payment funding for MPP and x402 clients.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/tempoxyz/machine-fetch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempoxyz/machine-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/tempoxyz/machine-fetch/issues"
  },
  "keywords": [
    "fetch",
    "machine-payments",
    "mpp",
    "x402",
    "stablecoin",
    "viem"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mppx": {
      "types": "./dist/entries/mppx.d.ts",
      "default": "./dist/entries/mppx.js"
    },
    "./x402": {
      "types": "./dist/entries/x402.d.ts",
      "default": "./dist/entries/x402.js"
    },
    "./evm": {
      "types": "./dist/entries/evm.d.ts",
      "default": "./dist/entries/evm.js"
    },
    "./cross-chain": {
      "types": "./dist/entries/cross-chain.d.ts",
      "default": "./dist/entries/cross-chain.js"
    },
    "./relay": {
      "types": "./dist/entries/relay.d.ts",
      "default": "./dist/entries/relay.js"
    },
    "./privy": {
      "types": "./dist/entries/privy.d.ts",
      "default": "./dist/entries/privy.js"
    },
    "./stores/memory": {
      "types": "./dist/entries/stores/memory.d.ts",
      "default": "./dist/entries/stores/memory.js"
    },
    "./stores/local-storage": {
      "types": "./dist/entries/stores/local-storage.d.ts",
      "default": "./dist/entries/stores/local-storage.js"
    },
    "./stores/file": {
      "types": "./dist/entries/stores/file.d.ts",
      "default": "./dist/entries/stores/file.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@x402/core": ">=2.25.0 <3",
    "@x402/fetch": ">=2.25.0 <3",
    "mppx": ">=0.12.0 <0.14",
    "viem": ">=2.57.1 <3"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    },
    "@x402/fetch": {
      "optional": true
    }
  }
}
